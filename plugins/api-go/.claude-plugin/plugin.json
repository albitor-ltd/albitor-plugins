{
  "schema": 2,
  "name": "api-go",
  "displayName": "Go API runtime",
  "version": "0.2.0",
  "kind": "socket",
  "description": "The api-runtime plugin: a Go HTTP server skeleton with request logging and correlation ids, a middleware chain, routes and paging, a health route, an OpenAPI contract and the local test issuer, behind the api.middleware and api.routes slots.",
  "author": {
    "name": "Albitor Ltd",
    "email": "jamie@albitor.com"
  },
  "license": "MIT",
  "keywords": [
    "api",
    "api-runtime",
    "go",
    "http",
    "middleware",
    "pagination",
    "openapi"
  ],
  "provides": ["api-runtime@1"],
  "requires": ["deploy-target@1"],
  "contributes": {
    "files": [
      { "path": "api/go.mod", "mode": "managed" },
      { "path": "api/main.go", "mode": "managed" },
      { "path": "api/internal/apikit/**", "mode": "managed" },
      { "path": "api/internal/localauth/**", "mode": "managed" },
      { "path": "api/internal/shell/boot.go", "mode": "managed" },
      { "path": "api/internal/shell/shell.go", "mode": "managed" },
      { "path": "api/internal/shell/shell_test.go", "mode": "managed" },
      { "path": "api/internal/shell/router.go", "mode": "slot-template", "syntax": "go" },
      { "path": "api/internal/app/routes.go", "mode": "example" },
      { "path": "api/openapi.yaml", "mode": "example" },
      { "path": "api/.gitignore", "mode": "example" },
      { "path": "api/README.md", "mode": "example" }
    ],
    "slots": {
      "repo.dependabot": [{ "ecosystem": "gomod", "directory": "/api" }]
    },
    "manifest": {
      "build": {
        "api": { "command": "cd api && go build -o dist/api .", "output": "api/dist" }
      },
      "http": { "runtime": "go", "handler": "api" }
    },
    "skills": ["api-go"]
  }
}
