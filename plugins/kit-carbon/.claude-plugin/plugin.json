{
  "schema": 2,
  "name": "kit-carbon",
  "displayName": "Component kit (Carbon)",
  "version": "0.9.0",
  "description": "The component-kit plugin for Svelte in the IBM Carbon style: the styled shell pieces (UI shell with side nav, forms, tables, dialogs, toasts, empty states) on carbon-components-svelte, in Carbon's white and Gray 100 themes, which pass WCAG 2.2 AA contrast. Carbon is not themeable by a visual-language plugin.",
  "author": {
    "name": "Albitor Ltd",
    "email": "jamie@albitor.com"
  },
  "license": "MIT",
  "keywords": ["component-kit", "carbon", "carbon-components-svelte", "svelte", "accessibility"],
  "themeable": false,
  "kind": "socket",
  "provides": ["component-kit@1", "component-kit@2"],
  "requires": ["web-framework@1"],
  "contributes": {
    "dependencies": {
      "npm": [
        "carbon-components-svelte@0.113.1",
        "carbon-icons-svelte@13.16.0",
        "@ibm/telemetry-js@1.12.0",
        "axe-core@4.14.0",
        "jsdom@30.1.2",
        "@types/jsdom@30.0.0"
      ]
    },
    "files": [
      { "path": "web/knip.json", "mode": "example", "when": { "web-framework": "web-svelte" } },
      { "path": "web/vitest.config.ts", "mode": "example", "when": { "web-framework": "web-svelte" } },
      { "path": "web/src/lib/kit/vitest.setup.ts", "mode": "example", "when": { "web-framework": "web-svelte" } },
      { "path": "web/src/lib/kit/contrast.test.ts", "mode": "managed", "when": { "web-framework": "web-svelte" } },
      { "path": "web/src/lib/kit/AppShell.svelte", "mode": "example", "when": { "web-framework": "web-svelte" } },
      { "path": "web/src/lib/kit/Button.svelte", "mode": "example", "when": { "web-framework": "web-svelte" } },
      { "path": "web/src/lib/kit/Dialog.svelte", "mode": "example", "when": { "web-framework": "web-svelte" } },
      { "path": "web/src/lib/kit/EmptyState.svelte", "mode": "example", "when": { "web-framework": "web-svelte" } },
      { "path": "web/src/lib/kit/Field.svelte", "mode": "example", "when": { "web-framework": "web-svelte" } },
      { "path": "web/src/lib/kit/Footer.svelte", "mode": "example", "when": { "web-framework": "web-svelte" } },
      { "path": "web/src/lib/kit/Table.svelte", "mode": "example", "when": { "web-framework": "web-svelte" } },
      { "path": "web/src/lib/kit/Toaster.svelte", "mode": "example", "when": { "web-framework": "web-svelte" } },
      { "path": "web/src/lib/kit/toast.svelte.ts", "mode": "example", "when": { "web-framework": "web-svelte" } },
      { "path": "web/src/lib/kit/theme.ts", "mode": "example", "when": { "web-framework": "web-svelte" } },
      { "path": "web/src/lib/kit/index.ts", "mode": "example", "when": { "web-framework": "web-svelte" } },
      { "path": "web/src/lib/kit/SignInPage.svelte", "mode": "example", "when": { "web-framework": "web-svelte" } },
      { "path": "web/src/lib/kit/__fixtures__/dom.ts", "mode": "example", "when": { "web-framework": "web-svelte" } },
      { "path": "web/src/lib/kit/__fixtures__/nav.ts", "mode": "example", "when": { "web-framework": "web-svelte" } },
      { "path": "web/src/lib/kit/__fixtures__/ShellFixture.svelte", "mode": "example", "when": { "web-framework": "web-svelte" } },
      { "path": "web/src/lib/kit/__fixtures__/ButtonFixture.svelte", "mode": "example", "when": { "web-framework": "web-svelte" } },
      { "path": "web/src/lib/kit/__fixtures__/FieldFixture.svelte", "mode": "example", "when": { "web-framework": "web-svelte" } },
      { "path": "web/src/lib/kit/__fixtures__/TableFixture.svelte", "mode": "example", "when": { "web-framework": "web-svelte" } },
      { "path": "web/src/lib/kit/__fixtures__/EmptyStateFixture.svelte", "mode": "example", "when": { "web-framework": "web-svelte" } },
      { "path": "web/src/lib/kit/__fixtures__/DialogFixture.svelte", "mode": "example", "when": { "web-framework": "web-svelte" } },
      { "path": "web/src/lib/kit/kit.test.ts", "mode": "managed", "when": { "web-framework": "web-svelte" } },
      { "path": "web/src/lib/kit/button.test.ts", "mode": "example", "when": { "web-framework": "web-svelte" } },
      { "path": "web/src/lib/kit/field.test.ts", "mode": "example", "when": { "web-framework": "web-svelte" } },
      { "path": "web/src/lib/kit/table.test.ts", "mode": "example", "when": { "web-framework": "web-svelte" } },
      { "path": "web/src/lib/kit/emptystate.test.ts", "mode": "example", "when": { "web-framework": "web-svelte" } },
      { "path": "web/src/lib/kit/contract.test.ts", "mode": "example", "when": { "web-framework": "web-svelte" } },
      { "path": "web/src/lib/kit/__fixtures__/SignInHarness.svelte", "mode": "example", "when": { "web-framework": "web-svelte" } },
      { "path": "web/src/lib/kit/signin.test.ts", "mode": "example", "when": { "web-framework": "web-svelte" } },
      { "path": "web/src/lib/kit/__fixtures__/ContractProbe.svelte", "mode": "example", "when": { "web-framework": "web-svelte" } },
      { "path": "web/src/lib/kit/dialog.test.ts", "mode": "managed", "when": { "web-framework": "web-svelte" } },
      { "path": "web/src/lib/kit/shell.test.ts", "mode": "example", "when": { "web-framework": "web-svelte" } }
    ],
    "skills": ["kit-carbon"]
