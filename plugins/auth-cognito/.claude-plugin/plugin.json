{
  "schema": 2,
  "name": "auth-cognito",
  "displayName": "Auth (Amazon Cognito)",
  "version": "0.9.0",
  "kind": "socket",
  "description": "The auth plugin for the default profile: Amazon Cognito sign-up and sign-in. The API verifies tokens and serves GET /api/me, and the web side keeps a provider-independent session and a route guard. The sign-in calls, the sign-in, sign-up, confirm, reset screens, a Sign out button and the People admin are worked examples in the skill to copy and alter. It declares services.auth.",
  "author": {
    "name": "Albitor Ltd",
    "email": "jamie@albitor.com"
  },
  "license": "MIT",
  "keywords": [
    "auth",
    "cognito",
    "authentication",
    "sign-up",
    "sign-in",
    "jwt",
    "session",
    "route-guard"
  ],
  "provides": ["auth@1"],
  "requires": ["api-runtime@1", "web-framework@1", "component-kit@2"],
  "contributes": {
    "files": [
      { "path": "api/internal/identity/identity.go", "mode": "example", "when": { "api-runtime": "api-go" } },
      { "path": "api/internal/identity/identity_test.go", "mode": "example", "when": { "api-runtime": "api-go" } },
      { "path": "api/internal/shell/identity_verify.go", "mode": "example", "when": { "api-runtime": "api-go" } },
      { "path": "api/internal/shell/identity_token.go", "mode": "example", "when": { "api-runtime": "api-go" } },
      { "path": "api/internal/shell/identity_cognito.go", "mode": "example", "when": { "api-runtime": "api-go" } },
      { "path": "api/internal/shell/identity_test.go", "mode": "example", "when": { "api-runtime": "api-go" } },
      { "path": "api/internal/shell/identity_hardening_test.go", "mode": "example", "when": { "api-runtime": "api-go" } },
      { "path": "web/src/lib/auth/session.ts", "mode": "example", "when": { "web-framework": "web-svelte" } },
      { "path": "web/src/lib/auth/session.test.ts", "mode": "example", "when": { "web-framework": "web-svelte" } },
      { "path": "web/src/lib/auth/guard.ts", "mode": "example", "when": { "web-framework": "web-svelte" } },
      { "path": "web/src/lib/auth/guard.test.ts", "mode": "example", "when": { "web-framework": "web-svelte" } },
      { "path": "web/src/lib/shell/scope.d/auth-cognito.ts", "mode": "example", "when": { "web-framework": "web-svelte" } },
      { "path": "web/tests/auth/provider.ts", "mode": "example", "when": { "test-harness": "test-playwright" } }
    ],
    "slots": {
      "api.middleware": ["IdentityVerify"],
      "api.routes": ["IdentityRoutes"],
      "web.route-guard": "requireSession"
    },
    "manifest": {
      "services": {
        "auth": { "provider": "cognito", "posture": "private" }
      }
    },
    "journeys": ["sign-in"],
    "skills": ["auth-cognito"]
  }
}
