{
  "schema": 2,
  "name": "auth-hosted",
  "displayName": "Auth (hosted sign-in)",
  "version": "0.3.0",
  "kind": "socket",
  "description": "The auth plugin for the hosted lane: sign-in on the app's Amazon Cognito hosted page by the authorization code flow with PKCE, no password field in the app. The API redirects, finishes the callback, verifies the ID token, keeps the session in HttpOnly cookies, and serves GET /api/me, sign-out, account deletion and an email domain rule; the web side adds a route guard and the sign-in, sign-out, account and refusal screens on component-kit@2. It declares services.auth.",
  "author": {
    "name": "Albitor Ltd",
    "email": "jamie@albitor.com"
  },
  "license": "MIT",
  "keywords": [
    "auth",
    "cognito",
    "hosted-ui",
    "oauth",
    "pkce",
    "sign-in",
    "session",
    "route-guard"
  ],
  "provides": [
    "auth@1"
  ],
  "requires": [
    "api-runtime@1",
    "web-framework@1",
    "deploy-target@1",
    "component-kit@2"
  ],
  "contributes": {
    "files": [
      {
        "path": "api/internal/identity/identity.go",
        "mode": "example",
        "when": {
          "api-runtime": "api-go"
        }
      },
      {
        "path": "api/internal/identity/identity_test.go",
        "mode": "example",
        "when": {
          "api-runtime": "api-go"
        }
      },
      {
        "path": "api/internal/shell/identity_verify.go",
        "mode": "example",
        "when": {
          "api-runtime": "api-go"
        }
      },
      {
        "path": "api/internal/shell/identity_token.go",
        "mode": "example",
        "when": {
          "api-runtime": "api-go"
        }
      },
      {
        "path": "api/internal/shell/identity_hosted.go",
        "mode": "example",
        "when": {
          "api-runtime": "api-go"
        }
      },
      {
        "path": "api/internal/shell/identity_test.go",
        "mode": "example",
        "when": {
          "api-runtime": "api-go"
        }
      },
      {
        "path": "api/internal/shell/identity_hosted_test.go",
        "mode": "example",
        "when": {
          "api-runtime": "api-go"
        }
      },
      {
        "path": "web/src/lib/auth/session.ts",
        "mode": "example",
        "when": {
          "web-framework": "web-svelte"
        }
      },
      {
        "path": "web/src/lib/auth/session.test.ts",
        "mode": "example",
        "when": {
          "web-framework": "web-svelte"
        }
      },
      {
        "path": "web/src/lib/auth/guard.ts",
        "mode": "example",
        "when": {
          "web-framework": "web-svelte"
        }
      },
      {
        "path": "web/src/lib/auth/guard.test.ts",
        "mode": "example",
        "when": {
          "web-framework": "web-svelte"
        }
      },
      {
        "path": "web/src/lib/auth/client.ts",
        "mode": "example",
        "when": {
          "web-framework": "web-svelte"
        }
      },
      {
        "path": "web/src/lib/auth/client.test.ts",
        "mode": "example",
        "when": {
          "web-framework": "web-svelte"
        }
      },
      {
        "path": "web/src/lib/shell/scope.d/auth-hosted.ts",
        "mode": "example",
        "when": {
          "web-framework": "web-svelte"
        }
      },
      {
        "path": "web/src/routes/(auth)/**",
        "mode": "example",
        "when": {
          "web-framework": "web-svelte"
        }
      },
      {
        "path": "web/tests/auth/provider.ts",
        "mode": "example",
        "when": {
          "test-harness": "test-playwright"
        }
      },
      {
        "path": "web/tests/journeys/sign-in.spec.ts",
        "mode": "example",
        "when": {
          "web-framework": "web-svelte",
          "test-harness": "test-playwright"
        }
      }
    ],
    "slots": {
      "api.middleware": [
        "IdentityVerify"
      ],
      "api.routes": [
        "IdentityRoutes"
      ],
      "web.route-guard": "requireSession"
    },
    "manifest": {
      "services": {
        "auth": {
          "provider": "cognito",
          "posture": "private",
          "sign_up": "open"
        }
      }
    },
    "journeys": [
      "sign-in"
    ],
    "skills": [
      "auth-hosted"
    ]
  }
}
