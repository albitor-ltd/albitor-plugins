{
  "schema": 2,
  "name": "web-svelte",
  "displayName": "Web shell (SvelteKit)",
  "version": "0.4.3",
  "description": "The web-framework plugin for SvelteKit: a static SPA build, file routing, the shell that hosts providers, the route guard and the nav, error, 404 and offline pages, a small API client, both client data layers (online-only TanStack Query, or offline-first outbox and sync) with the one the platform selects as the entry point, and the web side of the local run contract.",
  "author": {
    "name": "Albitor Ltd",
    "email": "jamie@albitor.com"
  },
  "license": "MIT",
  "keywords": ["web-framework", "svelte", "sveltekit", "spa", "shell", "data-fetching", "offline-first", "sync"],
  "kind": "socket",
  "provides": ["web-framework@1"],
  "requires": ["component-kit@1", "deploy-target@1"],
  "contributes": {
    "dependencies": {
      "npm": [
        "svelte@5.57.2",
        "@sveltejs/kit@3.0.1",
        "@sveltejs/adapter-static@4.0.0",
        "@sveltejs/vite-plugin-svelte@7.3.1",
        "vite@8.3.4",
        "typescript@6.0.3",
        "svelte-check@4.7.6",
        "vitest@5.0.3",
        "@types/node@24.19.2",
        "@tanstack/svelte-query@6.3.2",
        "fake-indexeddb@6.2.5"
      ]
    },
    "files": [
      { "path": "web/package.json", "mode": "example" },
      { "path": "web/package-lock.json", "mode": "example" },
      { "path": "web/.gitignore", "mode": "example" },
      { "path": "web/vite.config.ts", "mode": "managed" },
      { "path": "web/tsconfig.json", "mode": "managed" },
      { "path": "web/scripts/local-serve.mjs", "mode": "managed" },
      { "path": "web/src/app.html", "mode": "slot-template", "syntax": "html" },
      { "path": "web/src/app.d.ts", "mode": "managed" },
      { "path": "web/src/service-worker/index.ts", "mode": "managed" },
      { "path": "web/src/service-worker/tsconfig.json", "mode": "managed" },
      { "path": "web/src/lib/shell/types.ts", "mode": "managed" },
      { "path": "web/src/lib/shell/scope.ts", "mode": "managed" },
      { "path": "web/src/lib/shell/scope.test.ts", "mode": "managed" },
      { "path": "web/src/lib/shell/nav.ts", "mode": "managed" },
      { "path": "web/src/lib/shell/nav.test.ts", "mode": "managed" },
      { "path": "web/src/lib/shell/guard.ts", "mode": "managed" },
      { "path": "web/src/lib/shell/guard.test.ts", "mode": "managed" },
      { "path": "web/src/lib/shell/api.ts", "mode": "managed" },
      { "path": "web/src/lib/shell/api.test.ts", "mode": "managed" },
      { "path": "web/src/lib/shell/ShellProviders.svelte", "mode": "managed" },
      { "path": "web/src/lib/shell/OfflineBanner.svelte", "mode": "managed" },
      { "path": "web/src/lib/shell/nav.generated.ts", "mode": "slot-template", "syntax": "ts" },
      { "path": "web/src/lib/shell/providers.generated.ts", "mode": "slot-template", "syntax": "ts" },
      { "path": "web/src/lib/data-layer/index.ts", "mode": "managed" },
      { "path": "web/src/lib/data-layer/online.ts", "mode": "managed" },
      { "path": "web/src/lib/data-layer/offline.ts", "mode": "managed" },
      { "path": "web/src/lib/shell/scope.d/data-layer.ts", "mode": "managed" },
      { "path": "web/src/lib/data/client.ts", "mode": "managed" },
      { "path": "web/src/lib/data/client.test.ts", "mode": "managed" },
      { "path": "web/src/lib/data/query.ts", "mode": "managed" },
      { "path": "web/src/lib/data/query.test.ts", "mode": "managed" },
      { "path": "web/src/lib/data/state.ts", "mode": "managed" },
      { "path": "web/src/lib/data/state.test.ts", "mode": "managed" },
      { "path": "web/src/lib/data/QueryProvider.svelte", "mode": "managed" },
      { "path": "web/src/lib/data/DataState.svelte", "mode": "managed" },
      { "path": "web/src/lib/data/DataState.test.ts", "mode": "managed" },
      { "path": "web/src/lib/sync/types.ts", "mode": "managed" },
      { "path": "web/src/lib/sync/engine.ts", "mode": "managed" },
      { "path": "web/src/lib/sync/engine.test.ts", "mode": "managed" },
      { "path": "web/src/lib/sync/memory.ts", "mode": "managed" },
      { "path": "web/src/lib/sync/fallback.ts", "mode": "managed" },
      { "path": "web/src/lib/sync/idb.ts", "mode": "managed" },
      { "path": "web/src/lib/sync/store.test.ts", "mode": "managed" },
      { "path": "web/src/lib/sync/testing.ts", "mode": "managed" },
      { "path": "web/src/lib/sync/session.ts", "mode": "managed" },
      { "path": "web/src/lib/sync/transport.ts", "mode": "managed" },
      { "path": "web/src/lib/sync/transport.test.ts", "mode": "managed" },
      { "path": "web/src/lib/sync/auto.ts", "mode": "managed" },
      { "path": "web/src/lib/sync/auto.test.ts", "mode": "managed" },
      { "path": "web/src/lib/sync/status.ts", "mode": "managed" },
      { "path": "web/src/lib/sync/status.test.ts", "mode": "managed" },
      { "path": "web/src/lib/sync/watch.ts", "mode": "managed" },
      { "path": "web/src/lib/sync/watch.test.ts", "mode": "managed" },
      { "path": "web/src/lib/sync/live.svelte.ts", "mode": "managed" },
      { "path": "web/src/lib/sync/context.ts", "mode": "managed" },
      { "path": "web/src/lib/sync/SyncProvider.svelte", "mode": "managed" },
      { "path": "web/src/lib/sync/SyncStatus.svelte", "mode": "managed" },
      { "path": "web/src/lib/sync/shell.test.ts", "mode": "managed" },
      { "path": "web/src/lib/sync/collections.ts", "mode": "example" },
      { "path": "web/src/lib/app/app.css", "mode": "example" },
      { "path": "web/src/routes/+layout.svelte", "mode": "managed" },
      { "path": "web/src/routes/+layout.ts", "mode": "managed" },
      { "path": "web/src/routes/+error.svelte", "mode": "example" },
      { "path": "web/src/routes/+page.svelte", "mode": "example" },
      { "path": "web/src/routes/nav.ts", "mode": "example" },
      { "path": "web/src/routes/offline/+page.svelte", "mode": "example" }
    ],
    "slots": {
      "web.providers": ["DataProvider"],
      "repo.dependabot": [{ "ecosystem": "npm", "directory": "/web" }]
    },
    "manifest": {
      "build": {
        "static": { "command": "cd web && npm install && npm run build", "output": "web/build" }
      },
      "site": { "spa": true }
    },
    "skills": ["svelte-shell", "data-online", "data-offline"]
  }
}
