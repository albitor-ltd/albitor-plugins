{
  "schema": 2,
  "name": "test-playwright",
  "displayName": "Playwright journey harness",
  "version": "0.1.0",
  "description": "The test-harness plugin: a Playwright journey harness with a watched browser context, one sign-in for the suite and local test identities, fixtures that clean up after themselves, an axe WCAG 2.2 A/AA audit, and a read-only CI workflow.",
  "author": {
    "name": "Albitor Ltd",
    "email": "jamie@albitor.com"
  },
  "license": "MIT",
  "keywords": [
    "test-harness",
    "playwright",
    "journeys",
    "e2e",
    "accessibility",
    "axe",
    "wcag"
  ],
  "kind": "socket",
  "provides": ["test-harness@1"],
  "requires": ["web-framework@1", "deploy-target@1"],
  "contributes": {
    "dependencies": {
      "npm": ["@playwright/test@1.63.0", "playwright-core@1.63.0", "@axe-core/playwright@4.13.0"]
    },
    "files": [
      { "path": "web/tests/package.json", "mode": "managed" },
      { "path": "web/tests/package-lock.json", "mode": "managed" },
      { "path": "web/tests/.gitignore", "mode": "managed" },
      { "path": "web/tests/playwright.config.ts", "mode": "managed" },
      { "path": "web/tests/auth.setup.ts", "mode": "managed" },
      { "path": "web/tests/helpers/**", "mode": "managed" },
      { "path": "web/tests/unit/**", "mode": "managed" },
      { "path": "web/tests/smoke.spec.ts", "mode": "managed" },
      { "path": "web/tests/a11y.spec.ts", "mode": "managed" },
      { "path": "web/tests/journeys/README.md", "mode": "example" },
      { "path": ".github/workflows/journeys.yml", "mode": "managed" }
    ],
    "slots": {
      "repo.dependabot": [
        { "ecosystem": "npm", "directory": "/web/tests" },
        { "ecosystem": "github-actions", "directory": "/" }
      ]
    },
    "skills": ["test-playwright", "wcag-22-aa"]
  }
}
