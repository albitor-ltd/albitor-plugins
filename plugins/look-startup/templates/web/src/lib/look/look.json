{
  "version": 1,
  "font_family": "Inter, Geist, \"SF Pro Text\", \"Segoe UI\", system-ui, sans-serif",
  "heading_font_family": "\"Inter Display\", Inter, Geist, \"SF Pro Display\", \"Segoe UI\", system-ui, sans-serif",
  "heading_weight": 600,
  "type_scale": {
    "small": "0.8125rem",
    "body": "0.9375rem",
    "heading": "1.125rem",
    "title": "1.75rem"
